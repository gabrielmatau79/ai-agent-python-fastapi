APP_NAME=AI Agent FastAPI
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ALLOW_ORIGINS=["*"]

AGENT_PROMPT=You are a helpful AI assistant. Use retrieved context when relevant and be honest about uncertainty.
DEFAULT_RESPONSE_LANGUAGE=en
LANGUAGE_DETECTION_ENABLED=true

LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_TIMEOUT_SECONDS=45

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

AGENT_MEMORY_TYPE=memory
AGENT_MEMORY_WINDOW=8
MEMORY_TTL_SECONDS=14400
REDIS_URL=redis://localhost:6379/0

RAG_PROVIDER=in_memory
RAG_DOCS_PATH=sample_docs
RAG_TOP_K=3
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE=memory
VECTOR_INDEX_NAME=agent-ia

LLM_TOOLS_CONFIG=[]
LLM_TOOLS_AUTH_TOKEN=
LLM_TOOLS_AUTH_HEADER=Authorization
LLM_TOOLS_AUTH_SCHEME=Bearer

MCP_SERVERS={}
MCP_TOOL_TIMEOUT_MS=20000
MCP_THROW_ON_LOAD_ERROR=false
MCP_USE_STANDARD_CONTENT_BLOCKS=true
MCP_AUTH_TOKEN=
MCP_AUTH_HEADER=Authorization

API_KEY_ENABLED=false
API_KEY_HEADER_NAME=X-API-Key
API_KEY_VALUE=
