APP_NAME=AI Agent FastAPI
APP_ENV=docker
APP_PORT=8000
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ALLOW_ORIGINS=["*"]
AGENT_PROMPT=You are a helpful AI assistant. Prefer retrieved context and be concise.
DEFAULT_RESPONSE_LANGUAGE=en
LANGUAGE_DETECTION_ENABLED=true
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:0.5b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_TIMEOUT_SECONDS=45
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:0.5b
AGENT_MEMORY_TYPE=redis
AGENT_MEMORY_WINDOW=8
MEMORY_TTL_SECONDS=14400
REDIS_URL=redis://redis:6379/0
RAG_PROVIDER=redis
RAG_DOCS_PATH=sample_docs
RAG_TOP_K=3
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE=redis
VECTOR_INDEX_NAME=agent-ia
LLM_TOOLS_CONFIG=[]
MCP_SERVERS={"localAgent":{"transport":"stdio","command":"python","args":["-m","app.mcp_server.server"],"optional":true}}
MCP_TOOL_TIMEOUT_MS=20000
MCP_THROW_ON_LOAD_ERROR=false
MCP_USE_STANDARD_CONTENT_BLOCKS=true
API_KEY_ENABLED=false
API_KEY_HEADER_NAME=X-API-Key
API_KEY_VALUE=
